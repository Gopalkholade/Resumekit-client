{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "ResumeKit desktop main window permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://*.hf.space/**"
        }
      ]
    }
  ]
}
