{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ResumeKit",
  "version": "0.1.0",
  "identifier": "dev.resumekit.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ResumeKit",
        "width": 1180,
        "height": 820,
        "minWidth": 760,
        "minHeight": 620,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost https://*.hf.space; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; frame-src blob:"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
